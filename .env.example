# FreeTrialFinder Configuration
# Copy this file to .env and fill in your details

# Telegram Bot Alerts (100% Free)
# 1. Message @BotFather on Telegram, send /newbot, get your BOT_TOKEN
# 2. Start a chat with your new bot, send a hello message
# 3. Message @userinfobot to get your numeric user ID (CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook Alerts (Optional)
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Minimum Usability Score Threshold (0-100)
# Default: 40 (Lenient: alerts on both verified IDE/API deals and potential promos)
MIN_SCORE=40

# State Persistence Path
STATE_FILE=data/seen_deals.json

# Channel Toggles
ENABLE_TELEGRAM=true
ENABLE_DISCORD=true
ENABLE_CONSOLE=true

# AI triage (decides what reaches your phone; without it only high-score deals alert)
# Default endpoint is Groq's free tier (about 1,000 requests/day, no card): https://console.groq.com/keys
ENABLE_AGENT=true
AGENT_API_KEY=
AGENT_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=openai/gpt-oss-120b
AGENT_MAX_PER_RUN=15
# Or OpenRouter: set OPENROUTER_API_KEY and leave AGENT_API_KEY empty
OPENROUTER_API_KEY=

# What you care about: edit profile.md, or set PROFILE to override it
# PROFILE_FILE=profile.md
DIGEST_MAX_ITEMS=10
DIGEST_MIN_GAP_HOURS=20
