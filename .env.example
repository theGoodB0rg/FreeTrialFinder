# FreeTrialFinder Configuration
# Copy this file to .env and fill in your details

# Telegram Bot Alerts (100% Free)
# 1. Message @BotFather on Telegram, send /newbot, get your BOT_TOKEN
# 2. Start a chat with your new bot, send a hello message
# 3. Message @userinfobot to get your numeric user ID (CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook Alerts (Optional)
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Minimum Usability Score Threshold (0-100)
# Default: 40 (Lenient: alerts on both verified IDE/API deals and potential promos)
MIN_SCORE=40

# State Persistence Path
STATE_FILE=data/seen_deals.json

# Channel Toggles
ENABLE_TELEGRAM=true
ENABLE_DISCORD=true
ENABLE_CONSOLE=true

# Verification Agent (optional; checks borderline POTENTIAL deals with an LLM)
# Get a key at https://openrouter.ai/keys . Free ":free" models cost nothing.
ENABLE_AGENT=false
OPENROUTER_API_KEY=
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Or use Groq's free tier (about 1,000 requests/day, no card), found by this tool itself:
# AGENT_BASE_URL=https://api.groq.com/openai/v1
# AGENT_API_KEY=gsk_...
# AGENT_MODEL=openai/gpt-oss-120b
AGENT_MAX_PER_RUN=10
